@model Yummygram.Models.HesapViewModel

@{
    ViewBag.Title = "Giriş Yap | Yummygram";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Yummygram - Giriş Yap</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            background: #f8f2e9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 42px;
            border-radius: 22px;
            box-shadow: 0 12px 40px rgba(70, 30, 30, .10);
        }

        .logo {
            color: #762b3b;
            font-size: 36px;
            font-weight: 800;
            text-align: center;
        }

        .subtitle {
            text-align: center;
            color: #927d78;
            margin-bottom: 30px;
        }

        .form-control {
            padding: 13px;
            border-radius: 10px;
        }

        .btn-yummy {
            background: #762b3b;
            color: white;
            border: none;
            padding: 13px;
            border-radius: 10px;
            font-weight: bold;
        }

            .btn-yummy:hover {
                background: #57202d;
                color: white;
            }

        .register-link {
            color: #762b3b;
            font-weight: bold;
            text-decoration: none;
        }

        footer {
            text-align: center;
            color: #a99c98;
            font-size: 11px;
            margin-top: 25px;
        }
    </style>
</head>

<body>
    <div class="login-card">

        <div class="logo">Yummygram</div>

        <p class="subtitle">Lezzetini paylaş, keşfet, değerlendir.</p>

        @using (Html.BeginForm("Giris", "Hesap", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                <label class="form-label">E-posta adresi</label>
                @Html.TextBoxFor(m => m.Eposta, new
                {
                    @class = "form-control",
                    placeholder = "E-posta adresiniz",
                    type = "email"
                })
                @Html.ValidationMessageFor(m => m.Eposta, "", new { @class = "text-danger" })
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre</label>
                @Html.PasswordFor(m => m.Sifre, new
                {
                    @class = "form-control",
                    placeholder = "Şifreniz"
                })
                @Html.ValidationMessageFor(m => m.Sifre, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-yummy w-100">
                GİRİŞ YAP
            </button>
        }

        <p class="text-center mt-4 mb-0">
            Hesabın yok mu?
            <a href="@Url.Action("Kayit", "Hesap")" class="register-link">Kayıt Ol</a>
        </p>

        <footer>
            ASP.NET MVC | Entity Framework | SQL Server | Bootstrap
        </footer>

    </div>
</body>
</html>